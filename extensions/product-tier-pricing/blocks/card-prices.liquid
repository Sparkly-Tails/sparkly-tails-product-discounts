{% comment %}
  App embed: puts the discount on product cards (collection pages, search results, related products and any other
  list of products). It finds the cards by their product links, so it does not depend on the theme's markup.
  What it prints is the index the app keeps in the shop metafield tier_card_index: the live discounts with their
  tiers and products. The script (card-prices.js) fetches the live prices of those products and paints the cards.
  Nothing is printed when no discount is live.
  The tier prices are kept in the shop's currency, so for a customer who sees another currency the script converts
  them (with Shopify.currency.rate, in the widget's currency component) and writes the amounts in the format of the
  theme's own money filter, of which a sample is printed here. The script cannot know the addresses of the files
  Shopify serves, so they are handed over here; the offer component, which every page with the embed needs, is preloaded.
{% endcomment %}
{%- assign card_index = shop.metafields['$app:smooth_discount'].tier_card_index -%}
{%- if card_index != blank -%}
  {%- capture component_urls_raw -%}
    {
      "cardOffer": {{ 'card-prices-offer.js' | asset_url | json }},
      "currency": {{ 'tier-pricing-currency.js' | asset_url | json }}
    }
  {%- endcapture -%}
  {%- assign component_urls_json = component_urls_raw | strip | escape -%}
  {{ 'card-prices-offer.js' | asset_url | preload_tag: as: 'script' }}
  <div
    data-smooth-discounts-cards
    hidden
    data-index='{{ card_index.value | json | escape }}'
    data-money-format='{{ shop.money_format | json | escape }}'
    data-root-url='{{ routes.root_url | json | escape }}'
    data-shop-currency='{{ shop.currency | json | escape }}'
    data-money-sample='{{ 123456 | money | json | escape }}'
    data-component-urls='{{ component_urls_json }}'
  ></div>
{%- endif -%}

{% schema %}
{
  "name": "t:card_prices_name",
  "target": "body",
  "stylesheet": "card-prices.css",
  "javascript": "card-prices.js",
  "settings": []
}
{% endschema %}
