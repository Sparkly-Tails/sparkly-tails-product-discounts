{% comment %}
  App embed: the pop-up that opens when a customer presses Checkout while a bundle they have started is not yet at
  its first tier. The script (bundle-popup.js) stops the press, works out which bundles are due, and shows a box for
  each one with the products still missing; when anything goes wrong the press goes ahead to checkout.
  What it prints is the index the app keeps in the shop metafield tier_card_index (the same one the product card
  prices read): the live discounts with their title, style, tiers and products. Nothing is printed when no discount is live.
  The script cannot know the addresses of the files Shopify serves, so they are handed over here; the parts that
  build the boxes and draw the pop-up are preloaded. The tier prices are kept in the shop's currency, so for a
  customer who sees another currency the script converts them (the widget's currency component) and writes the
  amounts in the format of the theme's own money filter, of which a sample is printed here.
{% endcomment %}
{%- assign card_index = shop.metafields['$app:smooth_discount'].tier_card_index -%}
{%- if card_index != blank -%}
  {%- capture component_urls_raw -%}
    {
      "popupBoxes": {{ 'bundle-popup-boxes.js' | asset_url | json }},
      "popupUi": {{ 'bundle-popup-ui.js' | asset_url | json }},
      "popupView": {{ 'bundle-popup-view.js' | asset_url | json }},
      "popupFacts": {{ 'bundle-popup-facts.js' | asset_url | json }},
      "popupParts": {{ 'bundle-popup-parts.js' | asset_url | json }},
      "currency": {{ 'tier-pricing-currency.js' | asset_url | json }}
    }
  {%- endcapture -%}
  {%- assign component_urls_json = component_urls_raw | strip | escape -%}
  {{ 'bundle-popup-boxes.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'bundle-popup-ui.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'bundle-popup-view.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'bundle-popup-facts.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'bundle-popup-parts.js' | asset_url | preload_tag: as: 'script' }}
  <div
    data-smooth-discounts-popup
    hidden
    data-index='{{ card_index.value | json | escape }}'
    data-money-format='{{ shop.money_format | json | escape }}'
    data-root-url='{{ routes.root_url | json | escape }}'
    data-shop-currency='{{ shop.currency | json | escape }}'
    data-money-sample='{{ 123456 | money | json | escape }}'
    data-component-urls='{{ component_urls_json }}'
    data-moss-color='{{ block.settings.moss_color | json | escape }}'
    data-cream-color='{{ block.settings.cream_color | json | escape }}'
    data-sun-color='{{ block.settings.sun_color | json | escape }}'
  ></div>
{%- endif -%}

{% schema %}
{
  "name": "t:bundle_popup_name",
  "target": "body",
  "stylesheet": "bundle-popup.css",
  "javascript": "bundle-popup.js",
  "settings": [
    {
      "type": "color",
      "id": "moss_color",
      "label": "t:moss_color_label",
      "default": "#434625"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "t:cream_color_label",
      "default": "#f3ecd9"
    },
    {
      "type": "color",
      "id": "sun_color",
      "label": "t:sun_color_label",
      "default": "#ffdc4c"
    }
  ]
}
{% endschema %}
