{% comment %}
  App embed: the pop-up that opens when a customer presses Checkout while a bundle they have started is not yet at
  its first tier. The script (bundle-popup.js) stops the press, works out which bundles are due, and shows a box for
  each one with the products still missing; when anything goes wrong the press goes ahead to checkout.
  What it prints is the index the app keeps in the shop metafield tier_card_index (the same one the product card
  prices read): the live discounts with their title, tiers and products. Nothing is printed when no discount is live.
  The look and the frequency are the store-wide ones saved on the Settings page (the shop metafield tier_settings, see
  src/settings/design.ts and src/settings/frequency.ts): accent, background, corner radius, flash bar tone, and whether
  the pop-up opens once per session or at every Checkout press. Where the store has not saved them, or a value is
  missing or unusable, the default applies: accent #434625, background #F5EFE1, radius 12, Olive Night, once per session.
  The script cannot know the addresses of the files Shopify serves, so they are handed over here; the parts that
  build the boxes and draw the pop-up are preloaded. The tier prices are kept in the shop's currency, so for a
  customer who sees another currency the script converts them (the widget's currency component) and writes the
  amounts in the format of the theme's own money filter, of which a sample is printed here.
{% endcomment %}
{%- assign card_index = shop.metafields['$app:smooth_discount'].tier_card_index -%}
{%- if card_index != blank -%}
  {%- assign settings_value = shop.metafields['$app:smooth_discount'].tier_settings.value -%}
  {%- assign design_value = settings_value.design -%}
  {%- assign style_accent = '#434625' -%}
  {%- assign style_background = '#F5EFE1' -%}
  {%- assign style_radius = 12 -%}
  {%- assign style_flash = '#2B2D17' -%}
  {%- assign style_frequency = 'session' -%}
  {%- if design_value != blank -%}
    {%- comment -%} The colour checks are written out here, not in a snippet: Shopify wraps an app snippet's output in HTML comments, which would end up inside the attribute and make the colour invalid. {%- endcomment -%}
    {%- assign accent_candidate = design_value.accentColor | strip | upcase -%}
    {%- assign accent_first = accent_candidate | slice: 0, 1 -%}
    {%- if accent_first == '#' and accent_candidate.size == 7 -%}
      {%- assign accent_leftover = accent_candidate | slice: 1, 8 | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'E' | remove: 'F' -%}
      {%- if accent_leftover == blank -%}{%- assign style_accent = accent_candidate -%}{%- endif -%}
    {%- endif -%}
    {%- assign candidate = design_value.backgroundColor | strip | upcase -%}
    {%- assign first_character = candidate | slice: 0, 1 -%}
    {%- if first_character == '#' and candidate.size == 7 or first_character == '#' and candidate.size == 9 -%}
      {%- assign leftover = candidate | slice: 1, 8 | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'E' | remove: 'F' -%}
      {%- if leftover == blank -%}{%- assign style_background = candidate -%}{%- endif -%}
    {%- endif -%}
    {%- if design_value.cornerRadius != blank -%}{%- assign style_radius = design_value.cornerRadius | plus: 0 | at_least: 0 | at_most: 24 -%}{%- endif -%}
    {%- case design_value.flashTone -%}
      {%- when 'pure-onyx' -%}{%- assign style_flash = '#111111' -%}
      {%- when 'deep-pine' -%}{%- assign style_flash = '#1B3A2D' -%}
      {%- when 'olive-night' -%}{%- assign style_flash = '#2B2D17' -%}
    {%- endcase -%}
  {%- endif -%}
  {%- if settings_value.popup.frequency == 'checkout' -%}{%- assign style_frequency = 'checkout' -%}{%- endif -%}
  {%- capture component_urls_raw -%}
    {
      "popupBoxes": {{ 'bundle-popup-boxes.js' | asset_url | json }},
      "popupUi": {{ 'bundle-popup-ui.js' | asset_url | json }},
      "popupView": {{ 'bundle-popup-view.js' | asset_url | json }},
      "popupFacts": {{ 'bundle-popup-facts.js' | asset_url | json }},
      "popupParts": {{ 'bundle-popup-parts.js' | asset_url | json }},
      "currency": {{ 'tier-pricing-currency.js' | asset_url | json }}
    }
  {%- endcapture -%}
  {%- assign component_urls_json = component_urls_raw | strip | escape -%}
  {{ 'bundle-popup-boxes.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'bundle-popup-ui.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'bundle-popup-view.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'bundle-popup-facts.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'bundle-popup-parts.js' | asset_url | preload_tag: as: 'script' }}
  <div
    data-smooth-discounts-popup
    hidden
    data-index='{{ card_index.value | json | escape }}'
    data-money-format='{{ shop.money_format | json | escape }}'
    data-root-url='{{ routes.root_url | json | escape }}'
    data-shop-currency='{{ shop.currency | json | escape }}'
    data-money-sample='{{ 123456 | money | json | escape }}'
    data-component-urls='{{ component_urls_json }}'
    data-moss-color='{{ style_accent | json | escape }}'
    data-cream-color='{{ style_background | json | escape }}'
    data-night-color='{{ style_flash | json | escape }}'
    data-radius='{{ style_radius | json | escape }}'
    data-frequency='{{ style_frequency | json | escape }}'
    data-sun-color='{{ block.settings.sun_color | json | escape }}'
  ></div>
{%- endif -%}

{% schema %}
{
  "name": "t:bundle_popup_name",
  "target": "body",
  "stylesheet": "bundle-popup.css",
  "javascript": "bundle-popup.js",
  "settings": [
    {
      "type": "color",
      "id": "sun_color",
      "label": "t:sun_color_label",
      "default": "#ffdc4c"
    }
  ]
}
{% endschema %}
