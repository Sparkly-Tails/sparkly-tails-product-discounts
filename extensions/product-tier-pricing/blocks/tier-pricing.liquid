{% comment %}
  The tier discount widget: the tag, the promo line, the tier chips and the progress rail. It draws no price of its own:
  while a tier applies, its script changes the amount in the theme's own product price (the theme's "Show price" setting
  must be on) to the unit price for the quantity chosen. Without a tier discount, or for a variant that is not a
  member, the theme's price stays as the theme drew it.
{% endcomment %}
{%- assign discount_metafield = product.metafields['$app:smooth_discount'].tier_discount -%}
{%- comment -%}
  A flash sale that has ended renders as a product without a tier discount: only
  the plain price. (The script also hides the widget at the end second without a
  reload, for a page that was opened before it.)
{%- endcomment -%}
{%- if discount_metafield != blank and discount_metafield.value.flash != blank -%}
  {%- assign flash_now = 'now' | date: '%s' | plus: 0 -%}
  {%- if flash_now >= discount_metafield.value.flash.endsAtUnix -%}
    {%- assign discount_metafield = nil -%}
  {%- endif -%}
{%- endif -%}
{%- assign selected_variant_id = product.selected_or_first_available_variant.id | prepend: 'gid://shopify/ProductVariant/' -%}
{%- assign discount_json = '{"tiers":[]}' -%}
{%- comment -%} The variants without stock: the widget hides itself for them. Listing the sold-out ones (not the available ones) means a variant the loop does not reach stays shown. {%- endcomment -%}
{%- assign first_sold_out = true -%}
{%- capture sold_out_variant_ids_json -%}
  [{%- for variant in product.variants -%}{%- unless variant.available -%}{%- unless first_sold_out -%},{%- endunless -%}{%- assign first_sold_out = false -%}{{ variant.id }}{%- endunless -%}{%- endfor -%}]
{%- endcapture -%}
{%- if discount_metafield != blank -%}
  {%- assign sibling_product_refs = product.metafields['$app:smooth_discount'].tier_sibling_products.value -%}
  {%- assign sibling_variant_refs = product.metafields['$app:smooth_discount'].tier_sibling_variants.value -%}
  {%- capture siblings_json -%}
    [
    {%- for sibling in discount_metafield.value.siblings -%}
      {%- assign sib_listed = false -%}
      {%- assign sib_title = nil -%}
      {%- assign sib_url = nil -%}
      {%- assign sib_image = nil -%}
      {%- assign sib_price = nil -%}
      {%- assign sib_available = false -%}
      {%- assign sib_cart_variant = nil -%}
      {%- if sibling.variantId != blank -%}
        {%- for ref in sibling_variant_refs -%}
          {%- assign ref_gid = ref.id | prepend: 'gid://shopify/ProductVariant/' -%}
          {%- if ref_gid == sibling.variantId -%}
            {%- assign sib_listed = true -%}
            {%- capture sib_title -%}{{ ref.product.title }} – {{ ref.title }}{%- endcapture -%}
            {%- capture sib_url -%}{{ ref.product.url }}?variant={{ ref.id }}{%- endcapture -%}
            {%- assign sib_price = ref.price -%}
            {%- assign sib_available = ref.available -%}
            {%- assign sib_cart_variant = ref.id -%}
            {%- assign sib_image_source = ref.featured_image | default: ref.product.featured_image -%}
            {%- if sib_image_source != blank -%}
              {%- assign sib_image = sib_image_source | image_url: width: 160 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for ref in sibling_product_refs -%}
          {%- assign ref_gid = ref.id | prepend: 'gid://shopify/Product/' -%}
          {%- if ref_gid == sibling.productId -%}
            {%- assign sib_listed = true -%}
            {%- assign sib_title = ref.title -%}
            {%- assign sib_url = ref.url -%}
            {%- comment -%} A whole-product member has one variant (the admin enforces it); with more, no stepper is offered. {%- endcomment -%}
            {%- if ref.variants.size == 1 -%}
              {%- assign sib_price = ref.variants.first.price -%}
              {%- assign sib_cart_variant = ref.variants.first.id -%}
            {%- endif -%}
            {%- assign sib_available = ref.available -%}
            {%- if ref.featured_image != blank -%}
              {%- assign sib_image = ref.featured_image | image_url: width: 160 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {
        "productId": {{ sibling.productId | json }},
        "variantId": {{ sibling.variantId | default: null | json }},
        "title": {{ sib_title | default: null | json }},
        "url": {{ sib_url | default: null | json }},
        "imageUrl": {{ sib_image | default: null | json }},
        "price": {{ sib_price | default: null | json }},
        "available": {{ sib_available | default: false | json }},
        "cartVariantId": {{ sib_cart_variant | default: null | json }},
        "listed": {{ sib_listed }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}
  {%- capture own_variant_options_json -%}
    [
    {%- assign own_first = true -%}
    {%- if discount_metafield.value.ownVariantIds == blank -%}
      {%- comment -%} Whole-product member: its single variant is this product's own row. {%- endcomment -%}
      {%- if product.variants.size == 1 -%}
        {%- assign own_variant = product.variants.first -%}
        {%- assign own_image_source = own_variant.featured_image | default: product.featured_image -%}
        {%- assign own_image = nil -%}
        {%- if own_image_source != blank -%}{%- assign own_image = own_image_source | image_url: width: 160 -%}{%- endif -%}
        { "variantId": {{ own_variant.id | prepend: 'gid://shopify/ProductVariant/' | json }}, "title": {{ product.title | json }}, "url": {{ product.url | json }}, "imageUrl": {{ own_image | default: null | json }}, "price": {{ own_variant.price | json }}, "available": {{ own_variant.available | json }}, "cartVariantId": {{ own_variant.id | json }} }
      {%- endif -%}
    {%- else -%}
      {%- for own_id in discount_metafield.value.ownVariantIds -%}
        {%- for own_variant in product.variants -%}
          {%- assign own_variant_gid = own_variant.id | prepend: 'gid://shopify/ProductVariant/' -%}
          {%- if own_variant_gid == own_id -%}
            {%- unless own_first -%},{%- endunless -%}
            {%- assign own_first = false -%}
            {%- assign own_image_source = own_variant.featured_image | default: product.featured_image -%}
            {%- assign own_image = nil -%}
            {%- if own_image_source != blank -%}{%- assign own_image = own_image_source | image_url: width: 160 -%}{%- endif -%}
            { "variantId": {{ own_id | json }}, "title": {{ own_variant.title | json }}, "url": {{ product.url | append: '?variant=' | append: own_variant.id | json }}, "imageUrl": {{ own_image | default: null | json }}, "price": {{ own_variant.price | json }}, "available": {{ own_variant.available | json }}, "cartVariantId": {{ own_variant.id | json }} }
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
    ]
  {%- endcapture -%}
  {%- capture discount_json_raw -%}
    {
      "title": {{ discount_metafield.value.title | json }},
      "tiers": {{ discount_metafield.value.tiers | json }},
      "siblings": {{ siblings_json }},
      "ownVariantIds": {{ discount_metafield.value.ownVariantIds | json }},
      "ownVariantOptions": {{ own_variant_options_json }},
      "selfVariantId": {{ selected_variant_id | json }}
    }
  {%- endcapture -%}
  {%- assign discount_json = discount_json_raw | strip | escape -%}
{%- endif -%}
{%- comment -%}
  The widget script (tier-pricing.js) loads its parts as separate small scripts when a page needs them: the
  model and the paint always, the flash sale only with a flash sale, the currency only for a customer who sees a
  currency other than the shop's, the siblings list the first time it is opened. The script cannot know the addresses of the files
  Shopify serves, so they are handed over here; the ones every page needs are preloaded.
{%- endcomment -%}
{%- capture component_urls_raw -%}
  {
    "model": {{ 'tier-pricing-model.js' | asset_url | json }},
    "paint": {{ 'tier-pricing-paint.js' | asset_url | json }},
    "flash": {{ 'tier-pricing-flash.js' | asset_url | json }},
    "siblings": {{ 'tier-pricing-siblings.js' | asset_url | json }},
    "currency": {{ 'tier-pricing-currency.js' | asset_url | json }}
  }
{%- endcapture -%}
{%- assign component_urls_json = component_urls_raw | strip | escape -%}
{{ 'tier-pricing-model.js' | asset_url | preload_tag: as: 'script' }}
{{ 'tier-pricing-paint.js' | asset_url | preload_tag: as: 'script' }}
{%- if discount_metafield != blank and discount_metafield.value.flash != blank -%}
  {{ 'tier-pricing-flash.js' | asset_url | preload_tag: as: 'script' }}
{%- endif -%}

{%- comment -%}
  The look of this widget: the store-wide design saved on the Settings page (the shop metafield tier_settings, see
  src/settings/design.ts). Where the store has not saved a design, or a value is missing or unusable, the default
  applies: accent #434625, background #F5EFE1, radius 12, flash bar Olive Night. A colour must pass the hex check
  (a # and exactly six hexadecimal digits for the accent, six or eight for the background) and the radius is kept
  inside the range the Settings page allows.
{%- endcomment -%}
{%- assign design_value = shop.metafields['$app:smooth_discount'].tier_settings.value.design -%}
{%- assign style_accent = '#434625' -%}
{%- assign style_background = '#F5EFE1' -%}
{%- assign style_radius = 12 -%}
{%- assign style_flash = '#2B2D17' -%}
{%- if design_value != blank -%}
  {%- comment -%} The colour checks are written out here, not in a snippet: Shopify wraps an app snippet's output in HTML comments, which would end up inside the style attribute and make the colour invalid. {%- endcomment -%}
  {%- assign accent_candidate = design_value.accentColor | strip | upcase -%}
  {%- assign accent_first = accent_candidate | slice: 0, 1 -%}
  {%- if accent_first == '#' and accent_candidate.size == 7 -%}
    {%- assign accent_leftover = accent_candidate | slice: 1, 8 | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'E' | remove: 'F' -%}
    {%- if accent_leftover == blank -%}{%- assign style_accent = accent_candidate -%}{%- endif -%}
  {%- endif -%}
  {%- assign candidate = design_value.backgroundColor | strip | upcase -%}
  {%- assign first_character = candidate | slice: 0, 1 -%}
  {%- if first_character == '#' and candidate.size == 7 or first_character == '#' and candidate.size == 9 -%}
    {%- assign leftover = candidate | slice: 1, 8 | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'E' | remove: 'F' -%}
    {%- if leftover == blank -%}{%- assign style_background = candidate -%}{%- endif -%}
  {%- endif -%}
  {%- if design_value.cornerRadius != blank -%}{%- assign style_radius = design_value.cornerRadius | plus: 0 | at_least: 0 | at_most: 24 -%}{%- endif -%}
  {%- case design_value.flashTone -%}
    {%- when 'pure-onyx' -%}{%- assign style_flash = '#111111' -%}
    {%- when 'deep-pine' -%}{%- assign style_flash = '#1B3A2D' -%}
    {%- when 'olive-night' -%}{%- assign style_flash = '#2B2D17' -%}
  {%- endcase -%}
{%- endif -%}
{%- capture style_vars -%}
  --smooth-discounts-moss: {{ style_accent }}; --smooth-discounts-cream: {{ style_background }}; --smooth-discounts-radius: {{ style_radius }}px; --smooth-discounts-flash-dark: {{ style_flash }};
{%- endcapture -%}

<div
  id="smooth-discounts-{{ block.id }}"
  class="smooth-discounts{% if discount_metafield != blank %} smooth-discounts--card{% endif %}"
  data-smooth-discounts
  data-discount='{{ discount_json }}'
  data-selected-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-product-id='{{ product.id | prepend: "gid://shopify/Product/" | json }}'
  data-base-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }}"
  data-money-format='{{ shop.money_format | json | escape }}'
  data-shop-currency='{{ shop.currency | json | escape }}'
  data-money-sample='{{ 123456 | money | json | escape }}'
  data-high-demand="{{ discount_metafield.value.highDemand | default: false }}"
  data-flash='{{ discount_metafield.value.flash | json | escape }}'
  data-component-urls='{{ component_urls_json }}'
  data-sold-out-variant-ids='{{ sold_out_variant_ids_json | strip }}'
  {% unless product.selected_or_first_available_variant.available %}hidden{% endunless %}
  style="{{ style_vars | strip | escape }}"
>
  <div class="smooth-discounts__flash" data-tier-pricing-flash data-variant="hidden" hidden>
    <div class="smooth-discounts__flash-main">
      <span class="smooth-discounts__flash-icon" aria-hidden="true"></span>
      <span class="smooth-discounts__flash-label" data-flash-label></span>
    </div>
    <div class="smooth-discounts__flash-side">
      <span class="smooth-discounts__flash-timer" data-flash-timer></span>
      <span class="smooth-discounts__flash-aside" data-flash-aside></span>
      <span class="smooth-discounts__flash-chip" data-flash-chip hidden><span class="smooth-discounts__flash-hourglass" aria-hidden="true"></span><span data-flash-chip-text></span></span>
    </div>
  </div>
  <div class="smooth-discounts__body">
    <div class="smooth-discounts__summary">
      <div class="smooth-discounts__price-row">
        <span class="smooth-discounts__tag" data-tier-pricing-tag hidden></span>
      </div>

      {%- if discount_metafield != blank -%}
        {%- comment -%} Empty mount point — JS (buildPromoLine) owns the wording. {%- endcomment -%}
        <p class="smooth-discounts__promo" data-tier-pricing-promo aria-live="polite" aria-atomic="true"></p>
      {%- endif -%}
    </div>

    <div class="smooth-discounts__card" data-tier-pricing-card hidden>
      <div class="smooth-discounts__tiers" data-tier-pricing-tiers></div>
      <div class="smooth-discounts__rail-card" data-tier-pricing-rail data-offer-state="progress">
        <div class="smooth-discounts__status-row" aria-live="polite" aria-atomic="true">
          <span class="smooth-discounts__status" data-tier-pricing-status></span>
          <span class="smooth-discounts__aside" data-tier-pricing-aside></span>
        </div>
        <div class="smooth-discounts__bar-wrap" data-tier-pricing-bar role="progressbar" aria-label="Discount progress">
          <div class="smooth-discounts__track">
            <div class="smooth-discounts__fill" data-tier-pricing-fill></div>
          </div>
          <div class="smooth-discounts__markers" data-tier-pricing-markers></div>
          <span class="smooth-discounts__dot" data-tier-pricing-dot></span>
        </div>
      </div>
      {%- if discount_metafield != blank -%}
        <div class="smooth-discounts__drawer" data-tier-pricing-drawer data-open="false">
          <button type="button" class="smooth-discounts__toggle" data-tier-pricing-toggle aria-expanded="false" aria-controls="smooth-discounts-list-{{ block.id }}">
            <span class="smooth-discounts__drawer-title">
              <svg class="smooth-discounts__icon smooth-discounts__icon--closed" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v5h-8V3zm2 2v1h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm8-3h8v9h-8v-9zm2 2v5h4v-5h-4z"/></svg>
              <svg class="smooth-discounts__icon smooth-discounts__icon--open" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/></svg>
              <span>Mix &amp; match flavours</span>
            </span>
            <span class="smooth-discounts__drawer-aside" aria-hidden="true">
              <svg class="smooth-discounts__chevron" viewBox="0 0 24 24" width="16" height="16" focusable="false"><path fill="currentColor" d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
              <span class="smooth-discounts__collapse">▲ Collapse</span>
            </span>
          </button>
          <div class="smooth-discounts__list" id="smooth-discounts-list-{{ block.id }}" data-tier-pricing-list hidden></div>
          <p class="smooth-discounts__chosen" data-tier-pricing-chosen hidden></p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if block.settings.custom_css != blank -%}
  <style>
    #smooth-discounts-{{ block.id }} {
      {{ block.settings.custom_css }}
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "t:name",
  "target": "section",
  "stylesheet": "tier-pricing.css",
  "javascript": "tier-pricing.js",
  "settings": [
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "t:custom_css_label",
      "info": "t:custom_css_info"
    }
  ]
}
{% endschema %}
