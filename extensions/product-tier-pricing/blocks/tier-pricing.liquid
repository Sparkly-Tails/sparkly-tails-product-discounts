{% comment %}
  This block replaces the theme's native Buy Buttons price line (its
  "Show price" setting must be turned off in the theme editor). It always
  renders a price — a live-updating tiered price when
  product.metafields['$app:smooth_discount'].tier_discount is present AND the
  currently-selected variant is one of its members, or a plain price
  otherwise.
{% endcomment %}
{%- assign discount_metafield = product.metafields['$app:smooth_discount'].tier_discount -%}
{%- comment -%}
  A flash sale that has ended renders as a product without a tier discount: only
  the plain price. (The script also hides the widget at the end second without a
  reload, for a page that was opened before it.)
{%- endcomment -%}
{%- if discount_metafield != blank and discount_metafield.value.flash != blank -%}
  {%- assign flash_now = 'now' | date: '%s' | plus: 0 -%}
  {%- if flash_now >= discount_metafield.value.flash.endsAtUnix -%}
    {%- assign discount_metafield = nil -%}
  {%- endif -%}
{%- endif -%}
{%- assign selected_variant_id = product.selected_or_first_available_variant.id | prepend: 'gid://shopify/ProductVariant/' -%}
{%- assign discount_json = '{"tiers":[]}' -%}
{%- if discount_metafield != blank -%}
  {%- assign sibling_product_refs = product.metafields['$app:smooth_discount'].tier_sibling_products.value -%}
  {%- assign sibling_variant_refs = product.metafields['$app:smooth_discount'].tier_sibling_variants.value -%}
  {%- capture siblings_json -%}
    [
    {%- for sibling in discount_metafield.value.siblings -%}
      {%- assign sib_listed = false -%}
      {%- assign sib_title = nil -%}
      {%- assign sib_url = nil -%}
      {%- assign sib_image = nil -%}
      {%- assign sib_price = nil -%}
      {%- assign sib_available = false -%}
      {%- assign sib_cart_variant = nil -%}
      {%- if sibling.variantId != blank -%}
        {%- for ref in sibling_variant_refs -%}
          {%- assign ref_gid = ref.id | prepend: 'gid://shopify/ProductVariant/' -%}
          {%- if ref_gid == sibling.variantId -%}
            {%- assign sib_listed = true -%}
            {%- capture sib_title -%}{{ ref.product.title }} – {{ ref.title }}{%- endcapture -%}
            {%- capture sib_url -%}{{ ref.product.url }}?variant={{ ref.id }}{%- endcapture -%}
            {%- assign sib_price = ref.price -%}
            {%- assign sib_available = ref.available -%}
            {%- assign sib_cart_variant = ref.id -%}
            {%- assign sib_image_source = ref.featured_image | default: ref.product.featured_image -%}
            {%- if sib_image_source != blank -%}
              {%- assign sib_image = sib_image_source | image_url: width: 160 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for ref in sibling_product_refs -%}
          {%- assign ref_gid = ref.id | prepend: 'gid://shopify/Product/' -%}
          {%- if ref_gid == sibling.productId -%}
            {%- assign sib_listed = true -%}
            {%- assign sib_title = ref.title -%}
            {%- assign sib_url = ref.url -%}
            {%- comment -%} A whole-product member has one variant (the admin enforces it); with more, no stepper is offered. {%- endcomment -%}
            {%- if ref.variants.size == 1 -%}
              {%- assign sib_price = ref.variants.first.price -%}
              {%- assign sib_cart_variant = ref.variants.first.id -%}
            {%- endif -%}
            {%- assign sib_available = ref.available -%}
            {%- if ref.featured_image != blank -%}
              {%- assign sib_image = ref.featured_image | image_url: width: 160 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {
        "productId": {{ sibling.productId | json }},
        "variantId": {{ sibling.variantId | default: null | json }},
        "title": {{ sib_title | default: null | json }},
        "url": {{ sib_url | default: null | json }},
        "imageUrl": {{ sib_image | default: null | json }},
        "price": {{ sib_price | default: null | json }},
        "available": {{ sib_available | default: false | json }},
        "cartVariantId": {{ sib_cart_variant | default: null | json }},
        "listed": {{ sib_listed }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}
  {%- capture own_variant_options_json -%}
    [
    {%- assign own_first = true -%}
    {%- if discount_metafield.value.ownVariantIds == blank -%}
      {%- comment -%} Whole-product member: its single variant is this product's own row. {%- endcomment -%}
      {%- if product.variants.size == 1 -%}
        {%- assign own_variant = product.variants.first -%}
        {%- assign own_image_source = own_variant.featured_image | default: product.featured_image -%}
        {%- assign own_image = nil -%}
        {%- if own_image_source != blank -%}{%- assign own_image = own_image_source | image_url: width: 160 -%}{%- endif -%}
        { "variantId": {{ own_variant.id | prepend: 'gid://shopify/ProductVariant/' | json }}, "title": {{ product.title | json }}, "url": {{ product.url | json }}, "imageUrl": {{ own_image | default: null | json }}, "price": {{ own_variant.price | json }}, "available": {{ own_variant.available | json }}, "cartVariantId": {{ own_variant.id | json }} }
      {%- endif -%}
    {%- else -%}
      {%- for own_id in discount_metafield.value.ownVariantIds -%}
        {%- for own_variant in product.variants -%}
          {%- assign own_variant_gid = own_variant.id | prepend: 'gid://shopify/ProductVariant/' -%}
          {%- if own_variant_gid == own_id -%}
            {%- unless own_first -%},{%- endunless -%}
            {%- assign own_first = false -%}
            {%- assign own_image_source = own_variant.featured_image | default: product.featured_image -%}
            {%- assign own_image = nil -%}
            {%- if own_image_source != blank -%}{%- assign own_image = own_image_source | image_url: width: 160 -%}{%- endif -%}
            { "variantId": {{ own_id | json }}, "title": {{ own_variant.title | json }}, "url": {{ product.url | append: '?variant=' | append: own_variant.id | json }}, "imageUrl": {{ own_image | default: null | json }}, "price": {{ own_variant.price | json }}, "available": {{ own_variant.available | json }}, "cartVariantId": {{ own_variant.id | json }} }
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
    ]
  {%- endcapture -%}
  {%- capture discount_json_raw -%}
    {
      "title": {{ discount_metafield.value.title | json }},
      "tiers": {{ discount_metafield.value.tiers | json }},
      "siblings": {{ siblings_json }},
      "ownVariantIds": {{ discount_metafield.value.ownVariantIds | json }},
      "ownVariantOptions": {{ own_variant_options_json }},
      "selfVariantId": {{ selected_variant_id | json }}
    }
  {%- endcapture -%}
  {%- assign discount_json = discount_json_raw | strip | escape -%}
{%- endif -%}
{%- assign time_discount_metafield = product.metafields['$app:smooth_discount'].time_discount -%}
{%- assign time_discount_json = '{}' -%}
{%- if time_discount_metafield != blank -%}
  {%- capture time_discount_data -%}
    {
      "startsAt": {{ time_discount_metafield.value.startsAt | json }},
      "endsAt": {{ time_discount_metafield.value.endsAt | json }},
      "pricingMode": {% if time_discount_metafield.value.pricingMode != nil %}{{ time_discount_metafield.value.pricingMode | json }}{% else %}null{% endif %},
      "amount": {% if time_discount_metafield.value.amount != nil %}{{ time_discount_metafield.value.amount | json }}{% else %}null{% endif %},
      "variantIds": {% if time_discount_metafield.value.variantIds != nil %}{{ time_discount_metafield.value.variantIds | json }}{% else %}null{% endif %},
      "items": {% if time_discount_metafield.value.items != nil %}{{ time_discount_metafield.value.items | json }}{% else %}null{% endif %}
    }
  {%- endcapture -%}
  {%- assign time_discount_json = time_discount_data | strip | escape -%}
{%- endif -%}

<div
  id="sparkly-tier-pricing-{{ block.id }}"
  class="sparkly-tier-pricing{% if discount_metafield != blank %} sparkly-tier-pricing--card{% endif %}"
  data-sparkly-tier-pricing
  data-discount='{{ discount_json }}'
  data-time-discount='{{ time_discount_json }}'
  data-selected-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-product-id='{{ product.id | prepend: "gid://shopify/Product/" | json }}'
  data-base-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }}"
  data-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price | default: 0 | divided_by: 100.0 | json }}"
  data-money-format='{{ shop.money_format | json | escape }}'
  data-high-demand="{{ discount_metafield.value.highDemand | default: false }}"
  data-flash='{{ discount_metafield.value.flash | json | escape }}'
  style="--sparkly-tier-price-font-size: {{ block.settings.price_font_size }}px; --sparkly-tier-moss: {{ block.settings.moss_color }}; --sparkly-tier-cream: {{ block.settings.cream_color }}; --sparkly-tier-sun: {{ block.settings.sun_color }};"
>
  <div class="sparkly-tier-pricing__flash" data-tier-pricing-flash data-variant="hidden" hidden>
    <div class="sparkly-tier-pricing__flash-main">
      <span class="sparkly-tier-pricing__flash-icon" aria-hidden="true"></span>
      <span class="sparkly-tier-pricing__flash-label" data-flash-label></span>
    </div>
    <div class="sparkly-tier-pricing__flash-side">
      <span class="sparkly-tier-pricing__flash-timer" data-flash-timer></span>
      <span class="sparkly-tier-pricing__flash-aside" data-flash-aside></span>
      <span class="sparkly-tier-pricing__flash-chip" data-flash-chip hidden><span class="sparkly-tier-pricing__flash-hourglass" aria-hidden="true"></span><span data-flash-chip-text></span></span>
    </div>
  </div>
  <div class="sparkly-tier-pricing__body">
    <div class="sparkly-tier-pricing__summary">
      <div class="sparkly-tier-pricing__price-row">
        <div class="sparkly-tier-pricing__price-group">
          <span class="sparkly-tier-pricing__now-label" data-tier-pricing-now-label hidden></span>
          <span class="sparkly-tier-pricing__price sparkly-tier-pricing__original-price" data-tier-pricing-price data-original-price="true">
            {{ product.selected_or_first_available_variant.price | money }}
          </span>
          <span class="sparkly-tier-pricing__price sparkly-tier-pricing__discounted-price" data-discounted-price hidden>
            {{ product.selected_or_first_available_variant.price | money }}
          </span>
          <span class="sparkly-tier-pricing__each-label" data-tier-pricing-each-label>each</span>
          <s class="sparkly-tier-pricing__struck" data-tier-pricing-struck hidden></s>
        </div>
        <span class="sparkly-tier-pricing__tag" data-tier-pricing-tag hidden></span>
      </div>

      {%- if discount_metafield != blank -%}
        {%- comment -%} Empty mount point — JS (buildPromoLine) owns the wording. {%- endcomment -%}
        <p class="sparkly-tier-pricing__promo" data-tier-pricing-promo aria-live="polite" aria-atomic="true"></p>
      {%- endif -%}
    </div>

    <div class="sparkly-tier-pricing__card" data-tier-pricing-card hidden>
      <div class="sparkly-tier-pricing__tiers" data-tier-pricing-tiers></div>
      <div class="sparkly-tier-pricing__rail-card" data-tier-pricing-rail data-offer-state="progress">
        <div class="sparkly-tier-pricing__status-row" aria-live="polite" aria-atomic="true">
          <span class="sparkly-tier-pricing__status" data-tier-pricing-status></span>
          <span class="sparkly-tier-pricing__aside" data-tier-pricing-aside></span>
        </div>
        <div class="sparkly-tier-pricing__bar-wrap" data-tier-pricing-bar role="progressbar" aria-label="Discount progress">
          <div class="sparkly-tier-pricing__track">
            <div class="sparkly-tier-pricing__fill" data-tier-pricing-fill></div>
          </div>
          <div class="sparkly-tier-pricing__markers" data-tier-pricing-markers></div>
          <span class="sparkly-tier-pricing__dot" data-tier-pricing-dot></span>
        </div>
      </div>
      {%- if discount_metafield != blank -%}
        <div class="sparkly-tier-pricing__drawer" data-tier-pricing-drawer data-open="false">
          <button type="button" class="sparkly-tier-pricing__toggle" data-tier-pricing-toggle aria-expanded="false" aria-controls="sparkly-tier-list-{{ block.id }}">
            <span class="sparkly-tier-pricing__drawer-title">
              <svg class="sparkly-tier-pricing__icon sparkly-tier-pricing__icon--closed" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v5h-8V3zm2 2v1h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm8-3h8v9h-8v-9zm2 2v5h4v-5h-4z"/></svg>
              <svg class="sparkly-tier-pricing__icon sparkly-tier-pricing__icon--open" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/></svg>
              <span>Mix &amp; match flavours</span>
            </span>
            <span class="sparkly-tier-pricing__drawer-aside" aria-hidden="true">
              <svg class="sparkly-tier-pricing__chevron" viewBox="0 0 24 24" width="16" height="16" focusable="false"><path fill="currentColor" d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
              <span class="sparkly-tier-pricing__collapse">▲ Collapse</span>
            </span>
          </button>
          <div class="sparkly-tier-pricing__list" id="sparkly-tier-list-{{ block.id }}" data-tier-pricing-list hidden></div>
          <p class="sparkly-tier-pricing__chosen" data-tier-pricing-chosen hidden></p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .sparkly-tier-pricing__original-price {
    transition: all 0.3s ease;
  }

  /* While a time-based discount runs, the regular price drops to the same
     struck, smaller, muted treatment the tier discounts use (see
     `.sparkly-tier-pricing__price s`), and the sale price — which keeps the
     normal price styling: theme heading font, bold, theme text colour — sits
     to its left. */
  .sparkly-tier-pricing__original-price[data-strike="true"] {
    font-weight: 400;
    font-size: calc(var(--sparkly-tier-price-font-size, 2.5rem) * 0.75);
    color: var(--color-secondary-text-main, #5b5c4e);
    text-decoration: line-through;
  }

  .sparkly-tier-pricing__discounted-price {
    order: -1;
  }
</style>

{%- if block.settings.custom_css != blank -%}
  <style>
    #sparkly-tier-pricing-{{ block.id }} {
      {{ block.settings.custom_css }}
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "t:name",
  "target": "section",
  "stylesheet": "tier-pricing.css",
  "javascript": "tier-pricing.js",
  "settings": [
    {
      "type": "range",
      "id": "price_font_size",
      "label": "t:price_font_size_label",
      "info": "t:price_font_size_info",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "moss_color",
      "label": "t:moss_color_label",
      "default": "#434625"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "t:cream_color_label",
      "default": "#f3ecd9"
    },
    {
      "type": "color",
      "id": "sun_color",
      "label": "t:sun_color_label",
      "default": "#ffdc4c"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "t:custom_css_label",
      "info": "t:custom_css_info"
    }
  ]
}
{% endschema %}
