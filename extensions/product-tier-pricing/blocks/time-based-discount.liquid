{% comment %}
  Time-based discount widget: the discounted price (struck-through original
  beside it) above a countdown to the end of the discount. The whole widget is
  hidden outside the active window (before startsAt / after endsAt), for
  variants the discount doesn't cover, and whenever the discounted price
  wouldn't actually be lower. All of that is decided in time-based-discount.js
  from the data below — the prices are derived from the live variant price, so
  they follow variant changes and product price edits.
{% endcomment %}

{%- assign discount_metafield = product.metafields.sparkly_product_discounts.time_based_discount -%}
{%- assign discount_data = '{}' -%}

{%- if discount_metafield != blank -%}
  {%- capture discount_data_raw -%}
    {
      "title": {{ discount_metafield.value.title | json }},
      "startsAt": {{ discount_metafield.value.startsAt | json }},
      "endsAt": {{ discount_metafield.value.endsAt | json }},
      "pricingMode": {% if discount_metafield.value.pricingMode != nil %}{{ discount_metafield.value.pricingMode | json }}{% else %}null{% endif %},
      "amount": {% if discount_metafield.value.amount != nil %}{{ discount_metafield.value.amount | json }}{% else %}null{% endif %},
      "variantIds": {% if discount_metafield.value.variantIds != nil %}{{ discount_metafield.value.variantIds | json }}{% else %}null{% endif %},
      "selectedVariantId": {{ product.selected_or_first_available_variant.id | json }},
      "variantPrices": {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {{ variant.price }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }
  {%- endcapture -%}
  {%- assign discount_data = discount_data_raw | strip | escape -%}
{%- endif -%}

<div
  data-sparkly-time-discount
  data-discount='{{ discount_data }}'
  data-money-format='{{ shop.money_format | json | escape }}'
  class="sparkly-time-discount"
  style="--sparkly-time-discount-price-font-size: {{ block.settings.price_font_size }}px;"
  hidden
>
  <div class="sparkly-time-discount__price-row" data-time-discount-price-row hidden>
    <span class="sparkly-time-discount__price" data-time-discount-discounted></span>
    <s class="sparkly-time-discount__original-price" data-time-discount-original></s>
  </div>
  <div class="sparkly-time-discount__label" data-time-discount-label>
    Sale ends in:
  </div>
  <div class="sparkly-time-discount__timer">
    <span class="sparkly-time-discount__unit" data-time-discount-days>00</span>
    <span class="sparkly-time-discount__sep">:</span>
    <span class="sparkly-time-discount__unit" data-time-discount-hours>00</span>
    <span class="sparkly-time-discount__sep">:</span>
    <span class="sparkly-time-discount__unit" data-time-discount-minutes>00</span>
    <span class="sparkly-time-discount__sep">:</span>
    <span class="sparkly-time-discount__unit" data-time-discount-seconds>00</span>
  </div>
</div>

<style>
  .sparkly-time-discount {
    font-family: var(--font-stack-body, inherit);
    color: var(--color-text-main, inherit);
    line-height: 1.4;
  }

  /* Same price treatment as the tier-pricing block: theme heading font, bold
     primary price, the struck original smaller and muted — no accent colour. */
  .sparkly-time-discount__price-row:not([hidden]) {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 4px;
  }

  .sparkly-time-discount__price {
    font-family: var(--font-stack-headings);
    font-weight: 700;
    font-size: var(--sparkly-time-discount-price-font-size, 44px);
    color: var(--color-text-main, inherit);
  }

  .sparkly-time-discount__original-price {
    font-family: var(--font-stack-headings);
    font-weight: 400;
    font-size: calc(var(--sparkly-time-discount-price-font-size, 44px) * 0.75);
    opacity: 0.6;
    text-decoration: line-through;
  }

  .sparkly-time-discount__label {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .sparkly-time-discount__timer {
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }

  .sparkly-time-discount__unit {
    display: inline-block;
    min-width: 2.5rem;
    text-align: center;
  }

  .sparkly-time-discount__sep {
    display: inline-block;
    margin: 0 0.25rem;
    opacity: 0.6;
  }
</style>

{% schema %}
{
  "name": "Countdown Timer",
  "target": "section",
  "javascript": "time-based-discount.js",
  "settings": [
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price font size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 44
    }
  ]
}
{% endschema %}
