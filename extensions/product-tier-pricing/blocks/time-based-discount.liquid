{% comment %}
  Time-based discount widget: the discount title, then a countdown of red
  DAY / HRS / MINS / SECS boxes to the end of the discount (styled in
  time-based-discount.css; box colour is the "Countdown box color" setting).
  The sale price itself is shown by the tier-pricing price block. The widget is hidden
  outside the active window (before startsAt / after endsAt), for variants the
  discount doesn't cover, and whenever the discounted price wouldn't actually
  be lower. All of that is decided in time-based-discount.js from the data
  below, using the live variant price, so it follows variant changes.
{% endcomment %}

{%- assign discount_metafield = product.metafields.sparkly_product_discounts.time_based_discount -%}
{%- assign discount_data = '{}' -%}

{%- if discount_metafield != blank -%}
  {%- capture discount_data_raw -%}
    {
      "title": {{ discount_metafield.value.title | json }},
      "startsAt": {{ discount_metafield.value.startsAt | json }},
      "endsAt": {{ discount_metafield.value.endsAt | json }},
      "pricingMode": {% if discount_metafield.value.pricingMode != nil %}{{ discount_metafield.value.pricingMode | json }}{% else %}null{% endif %},
      "amount": {% if discount_metafield.value.amount != nil %}{{ discount_metafield.value.amount | json }}{% else %}null{% endif %},
      "variantIds": {% if discount_metafield.value.variantIds != nil %}{{ discount_metafield.value.variantIds | json }}{% else %}null{% endif %},
      "items": {% if discount_metafield.value.items != nil %}{{ discount_metafield.value.items | json }}{% else %}null{% endif %},
      "selectedVariantId": {{ product.selected_or_first_available_variant.id | json }},
      "variantPrices": {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {{ variant.price }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }
  {%- endcapture -%}
  {%- assign discount_data = discount_data_raw | strip | escape -%}
{%- endif -%}

<div
  id="sparkly-time-discount-{{ block.id }}"
  class="sparkly-time-discount"
  data-sparkly-time-discount
  data-discount='{{ discount_data }}'
  style="--sparkly-time-discount-color: {{ block.settings.countdown_color }};"
  hidden
>
  <p class="sparkly-time-discount__label" data-time-discount-label></p>
  <div class="sparkly-time-discount__boxes">
    <div class="sparkly-time-discount__box">
      <span class="sparkly-time-discount__value" data-time-discount-days>00</span>
      <span class="sparkly-time-discount__unit">DAY</span>
    </div>
    <div class="sparkly-time-discount__box">
      <span class="sparkly-time-discount__value" data-time-discount-hours>00</span>
      <span class="sparkly-time-discount__unit">HRS</span>
    </div>
    <div class="sparkly-time-discount__box">
      <span class="sparkly-time-discount__value" data-time-discount-minutes>00</span>
      <span class="sparkly-time-discount__unit">MINS</span>
    </div>
    <div class="sparkly-time-discount__box">
      <span class="sparkly-time-discount__value" data-time-discount-seconds>00</span>
      <span class="sparkly-time-discount__unit">SECS</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:name_time_discount",
  "target": "section",
  "stylesheet": "time-based-discount.css",
  "javascript": "time-based-discount.js",
  "settings": [
    {
      "type": "color",
      "id": "countdown_color",
      "label": "t:countdown_color_label",
      "default": "#e35d4f"
    }
  ]
}
{% endschema %}
